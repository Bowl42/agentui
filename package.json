{
  "name": "@bowl42/agentui",
  "private": true,
  "version": "0.0.0",
  "description": "shadcn/ui registry for agent apps: the base-nova components with an accessible theme",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bowl42/agentui.git"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "registry:build": "shadcn build",
    "theme": "node scripts/theme.ts",
    "readme:version": "node scripts/readme-version.ts",
    "lint": "pnpm lint:eslint && pnpm lint:prettier",
    "lint:eslint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:prettier": "prettier --check --cache \"**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "pnpm typecheck:tsc && pnpm typecheck:ts5",
    "typecheck:tsc": "tsc -b",
    "typecheck:ts5": "node node_modules/typescript-5/bin/tsc -p tsconfig.strict.json --noEmit --lib ES2023,DOM,DOM.Iterable",
    "test": "vitest run",
    "test:chromium": "vitest run --project unit --project forced-colors --project 'storybook (chromium)' --project 'input (chromium)'",
    "storybook:build": "storybook build",
    "check:quick": "node scripts/check.ts quick",
    "check": "node scripts/check.ts",
    "check:pr": "node scripts/check.ts pr",
    "check:grid": "node scripts/check-grid.ts",
    "check:content": "node scripts/check-content.ts",
    "registry:check": "shadcn registry validate && node scripts/theme.ts --check && node scripts/registry-deps.ts",
    "upstream": "shadcn add --all --dry-run",
    "perf": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@lexical/react": "0.53.0",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lexical": "0.53.0",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.18.1",
    "recharts": "3.8.0",
    "shadcn": "4.23.0",
    "shiki": "4.6.0",
    "streamdown": "^2.7.1",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@streamdown/math": "1.0.3",
    "@streamdown/mermaid": "1.0.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-storybook": "10.6.5",
    "globals": "17.14.0",
    "katex": "0.16.47",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.6.5",
    "typescript": "6.0.3",
    "typescript-5": "npm:typescript@5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0"
}
